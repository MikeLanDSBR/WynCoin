{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WynCoin Wallet",
  "version": "0.1.0",
  "identifier": "br.wynledger.wyncoin.wallet",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WynCoin Wallet",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": "all"
  }
}
